{
  "name": "hardened-express-auth",
  "version": "0.1.0",
  "description": "Hardened Express auth demo: JWT in a __Host- cookie, fail-closed RBAC, per-IP rate limit and enumeration-safe account lockout.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node --env-file=.env src/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "supertest": "^7.3.1",
    "vitest": "^5.1.0"
  }
}
