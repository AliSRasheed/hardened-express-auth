{
  "name": "express-jwt-cookie-auth",
  "version": "0.1.0",
  "description": "A JWT in an HttpOnly + Secure cookie, login rate limiting with per-account lockout, and route-level RBAC for Express 5.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node --env-file=.env src/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "supertest": "^7.3.1",
    "vitest": "^5.1.0"
  }
}
